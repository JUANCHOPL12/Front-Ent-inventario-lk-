    {
        new("Vidrio Templado Tablet", "2 uds en Local 2003", 1),
        new("Teclado USB", "1 ud en Local 2039", 2)
    };

    private List<AlertaItem> TodaBajaRotacion { get; } = new()
    {
        new("Estuche Tablet 7\"", "42 días sin venta • Local 2003", 1),
        new("Padmouse Ergonómico XL", "35 días sin venta • Local 2039", 2)
    };

    private IEnumerable<AlertaItem> AlertasStockFiltradas =>
        SessionService.SedeFiltroId == null
            ? TodasAlertasStock
            : TodasAlertasStock.Where(a => a.SedeId == SessionService.SedeFiltroId);

    private IEnumerable<AlertaItem> BajaRotacionFiltrada =>
        SessionService.SedeFiltroId == null
            ? TodaBajaRotacion.Take(1)
            : TodaBajaRotacion.Where(a => a.SedeId == SessionService.SedeFiltroId);

    public void Dispose() => SessionService.OnChange -= RefrescarVista;
